# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase shop database. The publishable key is safe for browser use, but this
# app currently performs all database access on the server with the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Sarvam-only voice agent (copy these into voice-agent/.env too)
LIVEKIT_URL=wss://your-project.livekit.cloud
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b-conversations

# Optional: the local app receives transcript events from the agent.
APP_WEBHOOK_URL=http://localhost:3000/api/conversations
APP_WEBHOOK_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_DEMO_MODE=false
