# Web app
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase shop database. The publishable key is safe for browser use, but this
# app currently performs all database access on the server with the secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR_DATABASE_PASSWORD@aws-0-your-region.pooler.supabase.com:6543/postgres
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Voice agent (copy these into voice-agent/.env too)
LIVEKIT_URL=wss://your-project.livekit.cloud
SARVAM_API_KEY=
GOOGLE_API_KEY=

# LLM failover. Providers without an API key are skipped automatically.
LLM_PROVIDER_ORDER=gemini,groq-gpt-oss,groq-qwen,openrouter
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_GPT_OSS_MODEL=openai/gpt-oss-120b
GROQ_QWEN_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional: the local app receives transcript events from the agent.
APP_WEBHOOK_URL=http://localhost:3000/api/conversations
APP_WEBHOOK_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_DEMO_MODE=false

# Twilio inbound phone calls. TWILIO_VOICE_WEBHOOK_URL must exactly match the
# public URL configured under "A call comes in" so request signatures validate.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Fixed, verified destination for the protected admin "Call me" button.
TWILIO_CALL_ME_NUMBER=+91XXXXXXXXXX
TWILIO_VOICE_WEBHOOK_URL=https://your-public-domain.example/api/twilio/voice
TWILIO_STATUS_WEBHOOK_URL=https://your-public-domain.example/api/twilio/status
# Development only. Never disable signature validation in production.
TWILIO_VALIDATE_SIGNATURES=true
